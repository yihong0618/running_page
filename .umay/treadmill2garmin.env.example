# 安装到 /etc/treadmill2garmin.env, 然后:  sudo chmod 600 /etc/treadmill2garmin.env
# 不要提交到 git, 也不要写进命令行参数 (ps 能看到)。

# 必填: python run_page/get_garmin_secret.py <邮箱> <密码> --is-cn  输出的那串
GARMIN_SECRET_STRING_CN=

# 跑步机广播名前缀 (你的是 Umay-A7H-0E2905); 想锁死某一台就填地址
T2G_DEVICE_NAME=Umay-
# T2G_DEVICE_ADDRESS=AA:BB:CC:DD:EE:FF

T2G_DATA_DIR=/var/lib/treadmill2garmin
T2G_TZ=Asia/Shanghai

# 可选调参 (括号内为默认值)
# T2G_MIN_SECONDS=30      短于此的会话丢弃
# T2G_MIN_METERS=20       短于此的会话丢弃
# T2G_PAUSE_END_S=90      按停止后多久没恢复/没 Reset 就结束
# T2G_IDLE_END_S=60       速度为 0 (没按停止) 多久后结束
# T2G_STALE_S=20          已连接但多久没数据就重连 (0=关闭)
# T2G_HR_MIN_COVERAGE=0.5 有效心率占比低于此则不写心率
# T2G_NO_UPLOAD=1         只生成 FIT 不上传 (调试用)
